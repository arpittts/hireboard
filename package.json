{
  "name": "hireboard",
  "version": "1.0.0",
  "description": "Personal Job & Internship Application Tracker",
  "private": true,
  "scripts": {
    "server": "cd server && node index.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "db:init": "cd server && node config/initDb.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
