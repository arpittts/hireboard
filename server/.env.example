# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hireboard

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Email (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=HireBoard <noreply@hireboard.app>

# Server
PORT=5000
CLIENT_URL=http://localhost:5173
