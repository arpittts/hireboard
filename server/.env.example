# Database (docker compose up -d db starts this one on port 5433)
DATABASE_URL=postgresql://hireboard:hireboard@localhost:5433/hireboard
# Neon (production): postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Failed login/register attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT=10

# Shared secret for the daily GitHub Actions job (/api/internal/*). Leave unset to disable.
# CRON_SECRET=any-long-random-string

# AI (Gemini free tier; get a key at https://aistudio.google.com/apikey).
# Without a key the AI features answer 503 and everything else works.
# GEMINI_API_KEY=your-key
LLM_MODEL=gemini-3.5-flash-lite
# live (default) | record (save replies to evals/recordings) | replay (answer from recordings, offline)
AI_MODE=live
AI_GLOBAL_DAILY_LIMIT=300

# Email for follow-up reminders (optional; Gmail with an app password works)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=HireBoard <your-email@gmail.com>

# Server
PORT=5001
CLIENT_URL=http://localhost:5173
