{
  "name": "hireboard-server",
  "version": "1.0.0",
  "description": "HireBoard API - Job Application Tracker",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "eval:jd": "AI_MODE=replay tsx scripts/eval-jd.ts",
    "eval:jd:record": "AI_MODE=record tsx scripts/eval-jd.ts",
    "eval:req": "AI_MODE=replay tsx scripts/eval-requirements.ts",
    "eval:req:record": "AI_MODE=record tsx scripts/eval-requirements.ts",
    "eval": "npm run eval:jd && npm run eval:req"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.104",
    "ai": "^7.0.150",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "type": "module",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
