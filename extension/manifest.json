{
  "manifest_version": 3,
  "name": "Save to HireBoard",
  "version": "1.0.0",
  "description": "Save the job posting you're looking at to HireBoard. Reads the page only when you click Save.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Save to HireBoard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://hireboard-mu.vercel.app/*",
      "http://localhost:5173/*",
      "http://localhost:5174/*"
    ]
  }
}
